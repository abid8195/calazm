# Copy to .env and fill in. Every variable the app reads is listed here.

# --- Required ---------------------------------------------------------------

# Prisma datasource (prisma/schema.prisma). SQLite file for local dev; a
# postgresql:// URL once the schema provider is switched for production.
DATABASE_URL="file:./dev.db"

# HMAC key for signing session cookies (lib/session.ts). Use a long random
# string in production; anyone with this value can forge sessions.
SESSION_SECRET="change-me-to-a-long-random-string"

# --- Optional: AI ------------------------------------------------------------

# Anthropic API key (lib/ai/provider.ts). When set, photo scans use Claude
# vision, unmatched text phrases use Haiku, and weekly reviews use a
# frontier model. When unset, the app runs the offline LocalProvider:
# text logging still works; photo recognition does not.
ANTHROPIC_API_KEY=""

# --- Optional: monetization / admin -----------------------------------------

# Email of the account allowed to open /admin (app/api/admin/metrics/route.ts).
# Leave empty to disable the dashboard entirely.
ADMIN_EMAIL=""

# Google AdSense publisher id, e.g. ca-pub-1234567890 (components/AdSlot.tsx).
# Shown to free-tier users only. When empty, a labeled house ad for Plus is
# shown instead. NEXT_PUBLIC_ prefix means this is exposed to the browser.
NEXT_PUBLIC_ADSENSE_ID=""

# --- Optional: native shell --------------------------------------------------

# Production HTTPS URL the Capacitor iOS/Android shell loads (capacitor.config.ts).
# Only read at `npx cap sync` time, not by the web app.
CALAZM_APP_URL=""

# --- Runtime (usually set by the host, not by you) --------------------------

# NODE_ENV: "production" disables the Prisma client singleton reuse used for
# dev hot-reload (lib/db.ts). Next.js sets this automatically.
# PORT: set in the Dockerfile (3000); Next.js listens on it.

# --- Scripts only ------------------------------------------------------------

# TEST_ADMIN_EMAIL: used by scripts/store-prep-test.mjs to sign in as the
# admin account against a running dev server. Not read by the app.
